---
// Header.astro - Navigation & Identity
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#0a0e17]/85 border-b border-[#1e293b]/80 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 rounded-lg p-1">
        <div class="relative w-9 h-9 rounded-xl overflow-hidden border border-sky-500/30 group-hover:border-sky-400 transition-all shadow-sm shadow-sky-950/50">
          <img src="/logo.png" alt="Kido Engineering" class="w-full h-full object-cover" width="36" height="36" />
        </div>
        <div class="flex flex-col">
          <span class="text-sm font-semibold tracking-tight text-slate-100 group-hover:text-sky-400 transition-colors">
            Kido Engineering
          </span>
          <span class="text-[10px] font-mono tracking-wider text-slate-400 uppercase">
            blog.khanhdp.com
          </span>
        </div>
      </a>
    </div>

    <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-slate-300">
      <a href="/" class="hover:text-sky-400 transition-colors">Bài Viết</a>
      <a href="/#categories" class="hover:text-sky-400 transition-colors">Chủ Đề</a>
      <a 
        href="https://truyen.khanhdp.com" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-gradient-to-r from-amber-500/10 to-orange-500/10 text-amber-300 border border-amber-500/25 hover:border-amber-400/50 hover:text-amber-200 transition-all"
      >
        <span>🎭 Ký Sự Truyện</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <a 
        href="https://khanhdp.com" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hover:text-sky-400 transition-colors flex items-center gap-1"
      >
        <span>Tác Giả</span>
        <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="https://github.com/khanhduong22"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="p-2 rounded-lg text-slate-400 hover:text-slate-100 hover:bg-slate-800/60 transition-colors"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
        </svg>
      </a>
      <a
        href="/rss.xml"
        aria-label="RSS Feed"
        class="p-2 rounded-lg text-amber-400 hover:text-amber-300 hover:bg-slate-800/60 transition-colors"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" />
        </svg>
      </a>
    </div>
  </div>
</header>
